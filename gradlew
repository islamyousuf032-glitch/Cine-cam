##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You will need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as ksh or
#       bash, then to run this script, type that shell name before the whole
#       command line, like:
#
#           ksh Gradle
#
#       Busybox and similar reduced shells will NOT work, because this script
#       requires all of these POSIX shell features:
#         * functions;
#         * expansions «$var», «${var}», «${var:-default}», «${var+SET}»,
#           «${var#prefix}», «${var%suffix}», and «$( cmd )»;
#         * compound commands having a testable exit status, especially «case»;
#         * various built-in commands including «command», «set», and «ulimit».
#
#       Important for patching:
#
#       (2) This script targets any POSIX shell, so it avoids extensions provided
#           by Bash, KFreeBSD, etc; in particular arrays are avoided.
#
#           The "traditional" practice of packing multiple parameters into a
#           single string parameter is not recommended here, because it may be
#           subject to globbing and word splitting.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

# This is normally unused
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case $( uname ) in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/shims/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/shims/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # In POSIX sh, ulimit -H is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC3045
        MAX_FD=$( ulimit -H -n ) ||
            warn "Could not query maximum file descriptor limit"
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        # In POSIX sh, ulimit -n is undefined. That's why the result is checked to see if it worked.
        # shellcheck disable=SC3045
        ulimit -n "$MAX_FD" ||
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# Collect all arguments for the java command, stacking in reverse order up to "after" the
# gradle-wrapper jar.
set -- \
        "-Dorg.gradle.appname=$APP_BASE_NAME" \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"

# Stop when "xargs" is not available.
if ! command -v xargs >/dev/null 2>&1
then
    die "xargs is not available"
fi

# Use "xargs" to parse quoted args.
#
# With -n1 it outputs one arg per line, with the quotes and backslashes removed.
#
# In Bash we could simply go:
#
#   readarray ARGS < <( xargs -n1 <<<"$var" ) &&
#   set -- "${ARGS[@]}" "$@"
#
# but POSIX shell has neither arrays nor command substitution within variadic
# assignments. Furthermore, POSIX shell does not have the feature to read
# null-delimited output from subprocesses. So we do it as a two-step process:
#
#   1. Parse the arguments with xargs, wrapping each argument in single quotes,
#      and delimiting each argument with a newline.
#   2. Read the output of xargs with a while loop. For each line, we remove the
#      surrounding single quotes, unescape single quotes and backslashes within
#      the string, and then add the string to the argument list.
#
# We also need to handle the case where xargs outputs nothing (i.e. when
# GRADLE_OPTS is empty). In that case, the output file will be empty.
# We also need to handle escaped characters properly when unescaping.

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS=""

# Collect all arguments for the java command:
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, and GRADLE_OPTS can contain fragments of
#     shell script including quotes and variable substitutions, so put them in
#     double quotes to make sure that they get re-expanded; and
#   * put the main class and its arguments (the Gradle invocation) in double
#     quotes as well, although this is redundant since we already quoted the
#     Gradle arguments above.
#
# We have to manually handle the quoting of the arguments, and unquoting of
# the output, because POSIX shell does not have arrays.

# The shell will expand "$@" into separate arguments when we source the
# gradle/gradle-daemon-jvm.properties file.

# This is normally unused
# shellcheck disable=SC2034
GRADLE_OPTS=

# shellcheck disable=SC2154
if [ -f "$APP_HOME/gradle/gradle-daemon-jvm.properties" ]; then
  # shellcheck disable=SC1091
  . "$APP_HOME/gradle/gradle-daemon-jvm.properties"
fi

# shellcheck disable=SC2086
set -- $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "$@"

# Stop when "xargs" is not available.
if ! command -v xargs >/dev/null 2>&1
then
    die "xargs is not available"
fi

# Create a temporary file for the xargs output
# In POSIX, mktemp is optional. So we provide a fallback using
# /tmp/Gradle-XXXXXXXXXX where XXXXXXXXXX is a random number.
if command -v mktemp >/dev/null 2>&1; then
    XARGS_OUTPUT_FILE=$(mktemp)
else
    XARGS_OUTPUT_FILE=/tmp/Gradle-$$
    touch "$XARGS_OUTPUT_FILE"
fi

# Parse the arguments with xargs, wrapping each argument in single quotes
# shellcheck disable=SC2086
echo $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS | xargs -n1 | sed "s/^/'/;s/$/'/" > "$XARGS_OUTPUT_FILE"

# Read the output of xargs with a while loop
# shellcheck disable=SC2162
while IFS= read -r line; do
    # Remove the surrounding single quotes
    line=${line#\'}
    line=${line%\'}
    # Unescape single quotes and backslashes
    # shellcheck disable=SC1003
    line=$(printf '%s' "$line" | sed "s/\\\\'/'/g; s/\\\\/\\\\/g")
    set -- "$line" "$@"
done < "$XARGS_OUTPUT_FILE"

# Clean up the temporary file
rm -f "$XARGS_OUTPUT_FILE"

# shellcheck disable=SC2086
exec "$JAVACMD" "$@"
